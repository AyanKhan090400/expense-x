# Copy this file to .env and fill in your Firebase project values.
# Firebase Console → Project settings → Your apps → Web app → SDK setup
#
# IMPORTANT (deploy):
# - Vite bakes these into the build at compile time (not runtime).
# - Local: keep values in .env (never commit .env).
# - Firebase Hosting: run `npm run deploy` (builds with .env, then deploys dist/).
# - Vercel/Netlify: add the same VITE_* variables in the dashboard before deploy.

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
